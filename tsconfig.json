{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": [
      "node",
      "react"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "App.tsx",
    "index.ts",
    "app.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    ".expo",
    ".refactor-backups"
  ]
}